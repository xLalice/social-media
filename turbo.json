{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"],
      "env": ["DATABASE_URL"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "outputs": []
    },
    "migrate:dev": {
      "cache": false
    }
  }
}
